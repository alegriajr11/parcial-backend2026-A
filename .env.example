# Puerto en el que se ejecutará el servidor
PORT=5000

# Configuración de Conexión a Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=citas_medicas_db

# Sincronización automática de entidades TypeORM (true para desarrollo)
DB_SYNC=true

# Mostrar consultas SQL en consola
DB_LOGGING=true
